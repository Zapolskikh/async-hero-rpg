# Environment of the release stack (Portainer: Stack → Environment variables, or "Load variables from .env file").

# Required: database password (any long random string).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Port on the home server that the Cloudflare Tunnel points to.
HTTP_PORT=8088

# Path of the game on the domain: https://games.imbapewpew.com/async-hero/
BASE_PATH=/async-hero

# Allowed browser origins for the API (the game itself is same-origin, this is for other tools).
CORS_ORIGINS=https://games.imbapewpew.com

# Image tag: "latest" follows main; a commit SHA pins a version.
TAG=latest

# Rules workers (Godot processes). 2 is enough for the first players; ~1 per CPU core.
WORKERS=2

# Test purchases ("Купить (тест)" grants crystals for free). Keep 0 in production.
ALLOW_FAKE_PURCHASES=0

# Admin endpoints (closing a Mythic+ season, reports). Empty disables them.
ADMIN_TOKEN=
