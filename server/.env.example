# Domain that points to this server (A record). Caddy gets the HTTPS certificate for it.
DOMAIN=api.example.com
# Database password (any long random string)
POSTGRES_PASSWORD=change-me-to-something-long
# Where the game client is served from (GitHub Pages). Use * only for testing.
CORS_ORIGINS=https://zapolskikh.github.io
# Godot rules processes (1 per CPU core is a good start)
WORKERS=2
# Max assist gold one hero owner can earn per day
ASSIST_DAILY_GOLD_CAP=3000
